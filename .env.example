# Puerto del servidor (default 3001). Render lo sobrescribe automáticamente.
PORT=3001

# Origen permitido por CORS.
# Desarrollo: "*"
# Producción (Render + Vercel): URL exacta del frontend, ej:
#   https://maia-landing.vercel.app
# Si tienes varios orígenes, sepáralos con coma:
#   https://maia-landing.vercel.app,https://maiabuilder.ai
CORS_ORIGIN=*

# --- PostgreSQL ---
# Desarrollo (local, peer auth Unix socket):
#   postgres:///maia-landing?host=/var/run/postgresql
# Producción (Render Postgres, Neon, Supabase, etc.):
#   postgres://user:password@host:5432/dbname
DATABASE_URL=postgres:///maia-landing?host=/var/run/postgresql

# Esquema donde vive la tabla `leads` (default: public)
DB_SCHEMA=public

# Forzar SSL en la conexión (requerido en Render Postgres / Neon / Supabase / RDS)
PGSSL=false

# --- Nodemailer / SMTP ---
# Si SMTP_HOST está vacío, el envío se omite y solo se guarda el lead en DB.
# Proveedores soportados:
#   Gmail (App Password):    smtp.gmail.com    : 465 SSL ← recomendado cuando 587 está bloqueado
#   Brevo (ex-Sendinblue):   smtp-relay.brevo.com : 587
#   Mailgun:                 smtp.mailgun.org  : 587
#   Amazon SES (us-east-1):  email-smtp.us-east-1.amazonaws.com : 587
#   Resend:                  smtp.resend.com   : 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From y To del correo notificador
# MAIL_FROM debe estar autorizado en tu proveedor SMTP (sender / domain verificado).
MAIL_FROM=noreply@maiabuilder.ai
MAIL_TO=maia@maiabuilder.ai

# --- Auth admin ---
# Secreto para firmar el JWT de sesión (HS256).
# Genera uno con: openssl rand -hex 48
# Si está vacío el server genera uno al boot (las sesiones se invalidan al reiniciar).
AUTH_SECRET=cambiar-en-produccion

# Para crear el primer admin:
#   node scripts/create-user.js admin@maiabuilder.ai mi-password "Admin"

# --- Admin inicial (seed-users) ---
MAIA_ADMIN_EMAIL=
MAIA_ADMIN_PASSWORD=
