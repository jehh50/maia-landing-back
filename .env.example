# Entorno de ejecución. En Render lo fija render.yaml a "production" (afecta
# cookieSecure/sameSite en src/auth.js, ver docs/architecture.md §8/§12). En
# local normalmente se deja sin definir (modo desarrollo).
NODE_ENV=development

# Puerto del servidor (default 3001). Render lo sobrescribe automáticamente.
PORT=3001

# Origen permitido por CORS.
# Desarrollo: "*"
# Producción (Render + Vercel): URL exacta del frontend, ej:
#   https://maia-landing.vercel.app
# Si tienes varios orígenes, sepáralos con coma:
#   https://maia-landing.vercel.app,https://maiabuilder.ai
CORS_ORIGIN=*

# --- PostgreSQL ---
# Desarrollo (local, peer auth Unix socket):
#   postgres:///maia-landing?host=/var/run/postgresql
# Producción (Render Postgres, Neon, Supabase, etc.):
#   postgres://user:password@host:5432/dbname
DATABASE_URL=postgres:///maia-landing?host=/var/run/postgresql

# Esquema donde vive la tabla `leads` (default: public)
DB_SCHEMA=public

# Forzar SSL en la conexión (requerido en Render Postgres / Neon / Supabase / RDS)
PGSSL=false

# --- Nodemailer / SMTP ---
# Si SMTP_HOST está vacío, el envío se omite y solo se guarda el lead en DB.
# Proveedores soportados:
#   Gmail (App Password):    smtp.gmail.com    : 465 SSL ← recomendado cuando 587 está bloqueado
#   Brevo (ex-Sendinblue):   smtp-relay.brevo.com : 587
#   Mailgun:                 smtp.mailgun.org  : 587
#   Amazon SES (us-east-1):  email-smtp.us-east-1.amazonaws.com : 587
#   Resend (SMTP):           smtp.resend.com   : 587
#   Resend (HTTP API, recomendado en Render/Railway para evitar bloqueo de
#   puertos SMTP salientes): SMTP_HOST=resend (valor literal, no un host real).
#   src/email.js usa entonces la librería `resend` en vez de nodemailer,
#   tomando la API key de SMTP_PASS (o SMTP_USER como fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From y To del correo notificador
# MAIL_FROM debe estar autorizado en tu proveedor SMTP (sender / domain verificado).
MAIL_FROM=noreply@maiabuilder.ai
MAIL_TO=maia@maiabuilder.ai

# --- Auth admin ---
# Secreto para firmar el JWT de sesión (HS256).
# Genera uno con: openssl rand -hex 48
# Si está vacío el server genera uno al boot (las sesiones se invalidan al reiniciar).
AUTH_SECRET=cambiar-en-produccion

# Ventana de renovación de sesión (feature 5, ms). Si a la cookie
# `maia_session` le queda menos que esto para expirar, una request
# autenticada (`GET /api/auth/me` o cualquier ruta admin) re-emite la cookie
# con una expiración nueva de 7 días. No se renueva en cada request, solo
# dentro de esta ventana; un token ya expirado nunca se renueva (401). Ver
# docs/architecture.md §8/§12. Si no está definida o el valor no es un
# número válido > 0, se usa el default (1 día = 86400000 ms).
AUTH_REFRESH_WINDOW_MS=86400000

# Para crear el primer admin:
#   node scripts/create-user.js admin@maiabuilder.ai mi-password "Admin"

# --- Admin inicial (seed-users) ---
MAIA_ADMIN_EMAIL=
MAIA_ADMIN_PASSWORD=

# --- Rate limiting (feature 3) ---
# Limita por IP POST /api/contact y POST /api/auth/login (en memoria, sin
# Redis — suficiente para el único proceso de Render free). Ver
# docs/architecture.md §12. Si no están definidas o el valor no es un número
# válido > 0, se usan los defaults.
# Ventana (ms) y máximo de leads por IP para POST /api/contact.
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX=20
# Ventana (ms) y máximo de intentos de login por IP para POST /api/auth/login.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Imágenes de secciones (feature 7) ---
# Tamaño máximo por archivo (en bytes) aceptado por POST /api/admin/images.
# Se aplica con `limits.fileSize` de multer; superarlo responde 413 en JSON.
# El binario se guarda en Postgres (columna BYTEA), así que este límite acota
# también lo que pesa cada fila. No es un secreto.
# Si no está definida o el valor no es un número válido > 0, se usa el default
# (5 MB = 5242880 bytes). Ver docs/architecture.md §7.1 y §12.
IMAGES_MAX_FILE_SIZE_BYTES=5242880
